# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Database base URL (without database name)
# For local development outside Docker:
# DATABASE_BASE_URL=postgresql://postgres:postgres@localhost:5432
# For Docker Compose:
# DATABASE_BASE_URL=postgresql://postgres:postgres@postgres:5432
DATABASE_BASE_URL=postgresql://postgres:postgres@localhost:5432

# MongoDB
MONGO_USERNAME=mongo
MONGO_PASSWORD=mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=audit_log

# Auth
# For local development use HS256 with a plain secret string.
# For production use RS256 with a PEM-encoded public key from your OIDC provider.
AUTH_JWT_SECRET=your-secret-or-pem-public-key
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_AUDIENCE=
JWT_ISS=https://auth.example.com
REDIS_PASSWORD=redis

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Kong API Gateway
KONG_RATE_LIMIT_PER_MINUTE=60
KONG_RATE_LIMIT_PER_HOUR=1000
JWT_ISS=https://auth.example.com
KONG_ADMIN_PORT=8001
KONG_PROXY_PORT=8000
