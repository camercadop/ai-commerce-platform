# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Database base URL (without database name)
DATABASE_BASE_URL=postgresql://postgres:postgres@localhost:5432

# MongoDB
MONGO_USERNAME=mongo
MONGO_PASSWORD=mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=audit_log

# Auth
AUTH_JWT_PUBLIC_KEY=your-public-key
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_AUDIENCE=

# Redis
REDIS_PASSWORD=redis

# Kong API Gateway
KONG_RATE_LIMIT_PER_MINUTE=60
KONG_RATE_LIMIT_PER_HOUR=1000
JWT_ISS=https://auth.example.com
KONG_ADMIN_PORT=8001
KONG_PROXY_PORT=8000
